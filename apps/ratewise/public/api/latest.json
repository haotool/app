        },
        "examples": {
          "TWD": {
            "customerBuyForeignRate": "rates.TWD.sell",
            "customerSellForeignRate": "rates.TWD.buy",
            "twdToKrw": "1000 * rates.TWD.sell"
          }
        },
        "bankComparison": {
