            "deprecated": true
          },
          "bankSellTwdPerUnit": {
            "legacyPath": "1 / sell",
            "description": "已棄用的誤命名欄位：實值為每 1 TWD 可換多少外幣（1 / sell），數值維持 v2 相容；新整合請使用 v3 fromCurrency/toCurrency/rate。",
            "deprecated": true
