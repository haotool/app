{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://app.haotool.org/ratewise/api/v3/contract.schema.json",
  "title": "FxContract",
  "$defs": {
    "SourceQuote": {
      "type": "object",
      "properties": {
        "providerId": {
          "type": "string",
          "maxLength": 512
        },
        "subjectCurrency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "maxLength": 512
        },
        "priceCurrency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "maxLength": 512
        },
        "unitAmount": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "maxLength": 512
        },
        "providerBuyPrice": {
          "description": "業者買入 subjectCurrency 的牌告價：每 unitAmount 單位 subjectCurrency 的 priceCurrency 金額；業者未報價為 null",
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
              "maxLength": 512
            },
            {
              "type": "null"
            }
          ]
        },
        "providerSellPrice": {
          "description": "業者賣出 subjectCurrency 的牌告價：每 unitAmount 單位 subjectCurrency 的 priceCurrency 金額；業者未報價為 null",
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
              "maxLength": 512
            },
            {
              "type": "null"
            }
          ]
        },
        "sourcePublishedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "maxLength": 512
            },
            {
              "type": "null"
            }
          ]
        },
        "fetchedAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 512
        },
        "lastSuccessfulCheckAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 512
        },
        "serviceCountry": {
          "type": "string",
          "pattern": "^[A-Z]{2}$",
          "maxLength": 512
        },
        "deliveryMethod": {
          "enum": ["cash", "account"]
        },
        "channel": {
          "enum": ["branch", "online", "atm", "unknown"]
        },
        "branchId": {
          "type": "string",
          "maxLength": 512
        },
        "denominations": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
            "maxLength": 512
          },
          "maxItems": 100
        },
        "amountRange": {
          "type": "object",
          "properties": {
            "currency": {
              "type": "string",
              "pattern": "^[A-Z]{3}$",
              "maxLength": 512
            },
            "min": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
              "maxLength": 512
            },
            "max": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
              "maxLength": 512
            }
          },
          "required": ["currency", "min", "max"]
        },
        "qualifications": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 512
          },
          "maxItems": 100
        },
        "feeStatus": {
          "enum": ["unknown", "no_additional_fee", "unsupported"]
        },
        "originalBuyField": {
          "type": "string",
          "maxLength": 512
        },
        "originalSellField": {
          "type": "string",
          "maxLength": 512
        },
        "mappingVersion": {
          "type": "string",
          "maxLength": 512
        },
        "originalUnitAmount": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "maxLength": 512
        },
        "dataKind": {
          "enum": ["published_board", "fixed_fallback", "reference", "derived_cross"]
        },
        "feeEvidenceUrl": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^https://"
        },
        "providerBuyUnavailableReason": {
          "enum": ["not_quoted", "not_collected", "market_closed", "suppressed"],
          "description": "providerBuyPrice 為 null 的原因；省略代表 not_quoted"
        },
        "providerSellUnavailableReason": {
          "enum": ["not_quoted", "not_collected", "market_closed", "suppressed"],
          "description": "providerSellPrice 為 null 的原因；省略代表 not_quoted"
        }
      },
      "required": [
        "providerId",
        "subjectCurrency",
        "priceCurrency",
        "unitAmount",
        "providerBuyPrice",
        "providerSellPrice",
        "sourcePublishedAt",
        "fetchedAt",
        "lastSuccessfulCheckAt",
        "serviceCountry",
        "deliveryMethod",
        "channel",
        "dataKind"
      ]
    },
    "QuoteSnapshot": {
      "type": "object",
      "properties": {
        "quoteId": {
          "type": "string",
          "maxLength": 256,
          "pattern": "^fx3:[^@\\s]+@[0-9T:.+\\-Z]+$",
          "description": "{quoteSeriesId}@{sourcePublishedAt|fetchedAt}"
        },
        "quoteSeriesId": {
          "type": "string",
          "maxLength": 256,
          "pattern": "^fx3:[^:@\\s]+:(cash|account):(branch|online|atm|unknown):[A-Z]{2}:[^:@\\s]+:[A-Z]{3}-[A-Z]{3}$",
          "description": "fx3:{provider}:{deliveryMethod}:{channel}:{country}:{branch|-}:{from}-{to}"
        },
        "providerId": {
          "type": "string",
          "maxLength": 512
        },
        "fromCurrency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "maxLength": 512
        },
        "toCurrency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "maxLength": 512
        },
        "status": {
          "enum": ["available", "unavailable"]
        },
        "rate": {
          "description": "每 1 fromCurrency 可取得的 toCurrency；來源直接值保留原始位數，倒數保留 12 位小數 ROUND_HALF_EVEN",
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
              "maxLength": 512
            },
            {
              "type": "null"
            }
          ]
        },
        "unavailableReason": {
          "enum": ["not_quoted", "not_collected", "market_closed", "suppressed", null],
          "description": "status=unavailable 的原因；null 代表可用。對應 ECB CL_OBS_STATUS。",
          "x-ecbObsStatus": {
            "not_quoted": "M",
            "not_collected": "L",
            "market_closed": "H",
            "suppressed": "Q"
          }
        },
        "sourceQuote": {
          "$ref": "#/$defs/SourceQuote"
        },
        "methodVersion": {
          "const": "1"
        }
      },
      "required": [
        "quoteId",
        "quoteSeriesId",
        "providerId",
        "fromCurrency",
        "toCurrency",
        "status",
        "rate",
        "unavailableReason",
        "sourceQuote",
        "methodVersion"
      ]
    },
    "EstimateRequest": {
      "type": "object",
      "properties": {
        "fromCurrency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "maxLength": 512
        },
        "toCurrency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "maxLength": 512
        },
        "amount": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "maxLength": 512
        },
        "mode": {
          "enum": ["EXACT_IN", "EXACT_OUT"]
        }
      },
      "required": ["fromCurrency", "toCurrency", "amount", "mode"],
      "additionalProperties": false
    },
    "EstimateResult": {
      "type": "object",
      "properties": {
        "status": {
          "enum": ["available", "unavailable"]
        },
        "fromAmount": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
              "maxLength": 512
            },
            {
              "type": "null"
            }
          ]
        },
        "toAmount": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
              "maxLength": 512
            },
            {
              "type": "null"
            }
          ]
        },
        "quoteId": {
          "type": ["string", "null"]
        },
        "rate": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
              "maxLength": 512
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "type": ["string", "null"]
        },
        "feeStatus": {
          "enum": ["unknown", "no_additional_fee", "unsupported"]
        }
      },
      "required": ["status", "fromAmount", "toAmount", "quoteId", "rate", "reason", "feeStatus"]
    },
    "SelectionContext": {
      "type": "object",
      "properties": {
        "now": {
          "type": "string",
          "format": "date-time",
          "maxLength": 512
        },
        "country": {
          "type": "string",
          "maxLength": 512
        },
        "deliveryMethod": {
          "enum": ["cash", "account"]
        },
        "channel": {
          "enum": ["branch", "online", "atm", "unknown"]
        },
        "branchId": {
          "type": "string",
          "maxLength": 512
        },
        "denomination": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "maxLength": 512
        },
        "qualifications": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 512
          }
        }
      },
      "required": ["now", "country", "deliveryMethod", "channel"],
      "additionalProperties": false
    },
    "DerivedCrossQuote": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "derived_cross"
        },
        "providerId": {
          "type": "string"
        },
        "fromCurrency": {
          "type": "string"
        },
        "toCurrency": {
          "type": "string"
        },
        "rate": {
          "type": "string"
        },
        "legs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "recommendable": {
          "const": false
        }
      },
      "required": [
        "kind",
        "providerId",
        "fromCurrency",
        "toCurrency",
        "rate",
        "legs",
        "recommendable"
      ]
    },
    "ObjectReference": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "maxLength": 512,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))[A-Za-z0-9_/-]+\\.json$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": ["path", "sha256"]
    },
    "Provider": {
      "type": "object",
      "properties": {
        "providerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "kind": {
          "enum": ["bank", "exchange_shop"]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "sourceUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "serviceCountries": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z]{2}$"
          },
          "minItems": 1
        },
        "termsUrl": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri",
              "pattern": "^https://"
            },
            {
              "type": "null"
            }
          ]
        },
        "redistributionStatus": {
          "enum": ["verified", "unknown", "restricted"]
        },
        "attribution": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "required": [
        "providerId",
        "kind",
        "name",
        "sourceUrl",
        "serviceCountries",
        "termsUrl",
        "redistributionStatus",
        "attribution"
      ]
    },
    "ProviderSnapshot": {
      "type": "object",
      "properties": {
        "$schema": {
          "const": "https://app.haotool.org/ratewise/api/v3/contract.schema.json"
        },
        "schemaVersion": {
          "const": "3.0"
        },
        "providerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "quotes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/QuoteSnapshot"
          },
          "minItems": 1,
          "maxItems": 10000
        }
      },
      "required": ["$schema", "schemaVersion", "providerId", "quotes"]
    },
    "ReleaseManifest": {
      "type": "object",
      "properties": {
        "$schema": {
          "const": "https://app.haotool.org/ratewise/api/v3/contract.schema.json"
        },
        "schemaVersion": {
          "const": "3.0"
        },
        "generatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "publisher": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "url": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://"
            },
            "termsUrl": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://"
            },
            "requiredText": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["name", "url", "termsUrl", "requiredText"]
        },
        "providers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "providerId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "snapshot": {
                "$ref": "#/$defs/ObjectReference"
              },
              "checkStatus": {
                "enum": ["ok", "failed", "carried_forward"]
              },
              "lastSuccessfulCheckAt": {
                "type": "string",
                "format": "date-time"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "kind": {
                "enum": ["bank", "exchange_shop"]
              },
              "sourceUrl": {
                "type": "string",
                "format": "uri",
                "pattern": "^https://"
              },
              "termsUrl": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "uri",
                    "pattern": "^https://"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "redistributionStatus": {
                "enum": ["verified", "unknown", "restricted"]
              },
              "attribution": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "nextSourceCheckAt": {
                "description": "選填：下次檢查時間，不承諾上游必然更新；未有排程承諾時不輸出（PRD §18.5），日後相容新增",
                "anyOf": [
                  {
                    "type": "string",
                    "format": "date-time"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "providerId",
              "snapshot",
              "checkStatus",
              "lastSuccessfulCheckAt",
              "name",
              "kind",
              "sourceUrl",
              "termsUrl",
              "redistributionStatus",
              "attribution"
            ]
          },
          "maxItems": 1000
        },
        "history": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "providerId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "date": {
                "type": "string",
                "format": "date"
              },
              "snapshot": {
                "$ref": "#/$defs/ObjectReference"
              }
            },
            "required": ["providerId", "date", "snapshot"]
          },
          "maxItems": 100000
        },
        "deprecation": {
          "type": "object",
          "properties": {
            "activatedAt": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ]
            },
            "sunsetAt": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ]
            },
            "replacement": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          },
          "required": ["activatedAt", "sunsetAt", "replacement"]
        },
        "calculationRule": {
          "const": "toAmount = fromAmount × rate（rate 為每 1 fromCurrency 的 toCurrency）；EXACT_OUT 以來源原值計算 fromAmount = ceil_minor(toAmount × unitAmount ÷ providerPrice)；倒數 rate 保留 12 位小數 ROUND_HALF_EVEN；金額依 ISO 4217 minor unit 捨入"
        },
        "quoteAvailability": {
          "const": "indicative_not_transaction_guarantee"
        }
      },
      "required": [
        "$schema",
        "schemaVersion",
        "generatedAt",
        "publisher",
        "providers",
        "history",
        "deprecation",
        "calculationRule",
        "quoteAvailability"
      ]
    },
    "CurrentRelease": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": "3.0"
        },
        "releaseId": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "manifest": {
          "$ref": "#/$defs/ObjectReference"
        }
      },
      "required": ["schemaVersion", "releaseId", "manifest"]
    },
    "DerivedEstimateResult": {
      "type": "object",
      "properties": {
        "status": {
          "enum": ["available", "unavailable"]
        },
        "fromAmount": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
              "maxLength": 512
            },
            {
              "type": "null"
            }
          ]
        },
        "toAmount": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
              "maxLength": 512
            },
            {
              "type": "null"
            }
          ]
        },
        "quoteId": {
          "type": ["string", "null"]
        },
        "rate": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
              "maxLength": 512
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "type": ["string", "null"]
        },
        "feeStatus": {
          "enum": ["unknown", "no_additional_fee", "unsupported"]
        },
        "kind": {
          "const": "derived_cross"
        },
        "legs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 2
        },
        "recommendable": {
          "const": false
        }
      },
      "required": [
        "status",
        "fromAmount",
        "toAmount",
        "quoteId",
        "rate",
        "reason",
        "feeStatus",
        "kind",
        "legs",
        "recommendable"
      ]
    }
  }
}
