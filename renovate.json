{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "Asia/Taipei",
  "schedule": ["before 3am on Monday"],
  "labels": ["dependencies"],
  "assignees": ["@s123104"],
  "packageRules": [
    {
      "description": "📦 Patch 更新 - 自動合併（所有依賴，排除 0.x）",
      "matchUpdateTypes": ["patch"],
      "matchCurrentVersion": "!/^0/",
      "groupName": "patch dependencies",
      "groupSlug": "patch",
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "squash",
      "platformAutomerge": true
    },
    {
      "description": "🔄 Minor 更新 - 自動合併（所有依賴，排除 0.x）",
      "matchUpdateTypes": ["minor"],
      "matchCurrentVersion": "!/^0/",
      "groupName": "minor dependencies",
      "groupSlug": "minor",
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "squash",
      "platformAutomerge": true
    },
    {
      "description": "⚠️ Major 更新 - 需要手動審查",
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "separateMajorMinor": true,
      "separateMultipleMajor": true,
      "labels": ["dependencies", "major-update"],
      "reviewers": ["@s123104"]
    },
    {
      "description": "🚨 安全更新 - 立即自動合併",
      "matchDatasources": ["npm"],
      "vulnerabilityAlerts": {
        "labels": ["security", "dependencies"],
        "automerge": true,
        "automergeType": "pr"
      }
    },
    {
      "description": "🔧 DevDependencies - 額外優先級",
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["patch", "minor"],
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "squash"
    },
    {
      "description": "📊 React Monorepo - 群組更新",
      "matchPackagePatterns": ["^react", "^@types/react"],
      "groupName": "React monorepo",
      "automerge": true
    },
    {
      "description": "🧪 測試工具 - 群組更新",
      "matchPackageNames": ["vitest", "@vitest/coverage-v8", "playwright", "@playwright/test"],
      "groupName": "test tools",
      "automerge": true
    },
    {
      "description": "🔒 @types/node - 跟隨 runtime 鎖在 Node 24，不接受 major 型別先行",
      "matchPackageNames": ["@types/node"],
      "allowedVersions": "^24"
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"]
  },
  "prConcurrentLimit": 10,
  "prHourlyLimit": 2,
  "stabilityDays": 3,
  "minimumReleaseAge": "3 days",
  "commitMessagePrefix": "chore(deps):",
  "commitMessageAction": "update",
  "commitMessageTopic": "{{depName}}",
  "commitMessageExtra": "to {{#if isPinDigest}}{{{newDigestShort}}}{{else}}{{#if isMajor}}{{prettyNewMajor}}{{else}}{{#if isSingleVersion}}{{prettyNewVersion}}{{else}}{{#if newValue}}{{{newValue}}}{{else}}{{{newDigestShort}}}{{/if}}{{/if}}{{/if}}{{/if}}",
  "prTitle": "{{commitMessagePrefix}} {{commitMessageAction}} {{commitMessageTopic}} {{commitMessageExtra}}",
  "prBodyTemplate": "{{{header}}}{{{table}}}{{{warnings}}}{{{notes}}}{{{changelogs}}}{{{configDescription}}}{{{controls}}}{{{footer}}}",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 3am on the first day of the month"]
  }
}
